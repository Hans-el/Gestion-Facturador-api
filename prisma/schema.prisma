// generar el cliente de Prisma. Si usamos prisma-client-js, debemos usar el import de la carpeta generada, no de @prisma/client
// Si usamos  
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  VENDEDOR
  BODEGUERO
  CONTADOR
}

// Tarifas de IVA del SRI (Ecuador).
// Más adelante, en facturación, las mapearemos a los códigos del SRI.
enum IvaRate {
  IVA_0
  IVA_5
  IVA_12
  IVA_13
  IVA_14
  IVA_15
  NO_OBJETO
  EXENTO
}

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  name             String
  passwordHash     String
  role             Role
  isActive         Boolean          @default(true)
  extraPermissions UserPermission[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  stockMovements   StockMovement[]
  sales            Sale[]           @relation("SaleSeller")
  voidedSales      Sale[]           @relation("SaleVoidedBy")

  @@index([role])
}

// Permisos adicionales a los que ya da el rol.
// Formato de "permission": "modulo:accion", por ejemplo "products:edit"
model UserPermission {
  id         String @id @default(uuid())
  userId     String
  permission String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String          @id @default(uuid())
  code        String          @unique
  name        String
  description String?
  categoryId  String
  category    Category        @relation(fields: [categoryId], references: [id])
  unit        String          @default("UNIDAD")
  price       Decimal         @db.Decimal(12, 2)
  cost        Decimal         @default(0) @db.Decimal(12, 2)
  ivaRate     IvaRate         @default(IVA_15)
  stock       Decimal         @default(0) @db.Decimal(12, 3)
  minStock    Decimal         @default(0) @db.Decimal(12, 3)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  movements   StockMovement[]
  saleItems   SaleItem[]

  @@index([categoryId])
  @@index([name])
}

enum MovementType {
  ENTRADA // ingreso de mercadería
  SALIDA // merma, daño, consumo interno
  AJUSTE // corrección por conteo físico
  VENTA // lo genera el módulo de ventas
  ANULACION // reversa de una venta anulada (módulo de ventas)
}

// Libro de movimientos: nunca se edita ni se borra
model StockMovement {
  id          String       @id @default(uuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  type        MovementType
  quantity    Decimal      @db.Decimal(12, 3) // con signo: positivo entra, negativo sale
  stockBefore Decimal      @db.Decimal(12, 3)
  stockAfter  Decimal      @db.Decimal(12, 3)
  reason      String?
  reference   String? // factura del proveedor, nota, etc.
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  createdAt   DateTime     @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
  @@index([type])
}

// Para facturacion
// Códigos del SRI: CEDULA=05, RUC=04, PASAPORTE=06, CONSUMIDOR_FINAL=07, EXTERIOR=08
enum IdentificationType {
  CEDULA
  RUC
  PASAPORTE
  CONSUMIDOR_FINAL
  EXTERIOR
}

model Customer {
  id        String             @id @default(uuid())
  idType    IdentificationType
  idNumber  String             @unique
  name      String // nombres y apellidos, o razón social
  email     String?
  phone     String?
  address   String?
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  sales     Sale[]

  @@index([name])
}

//para modulo de ventas
enum SaleStatus {
  COMPLETED
  VOIDED
}

// Equivalencias con el SRI (se confirman al integrar la facturación):
// EFECTIVO=01, TARJETA_DEBITO=16, TARJETA_CREDITO=19, TRANSFERENCIA=20
enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  TARJETA_DEBITO
  TARJETA_CREDITO
}

enum DiscountType {
  PERCENT
  AMOUNT
}

model Sale {
  id     String     @id @default(uuid())
  number Int        @unique @default(autoincrement()) // número interno; el de la factura vendrá aparte
  status SaleStatus @default(COMPLETED)

  customerId       String
  customer         Customer           @relation(fields: [customerId], references: [id])
  // Copia de los datos del cliente al momento de la venta
  customerIdType   IdentificationType
  customerIdNumber String
  customerName     String
  customerEmail    String?
  customerPhone    String?
  customerAddress  String?

  userId String
  user   User   @relation("SaleSeller", fields: [userId], references: [id])

  subtotal            Decimal       @db.Decimal(12, 2) // cantidad × precio, antes de descuentos
  discountTotal       Decimal       @db.Decimal(12, 2) // descuentos de línea + descuento general
  globalDiscountType  DiscountType?
  globalDiscountValue Decimal?      @db.Decimal(12, 2)
  taxableBase         Decimal       @db.Decimal(12, 2) // subtotal − descuentos (total sin impuestos)
  ivaTotal            Decimal       @db.Decimal(12, 2)
  total               Decimal       @db.Decimal(12, 2)

  notes String?

  voidedAt   DateTime?
  voidReason String?
  voidedById String?
  voidedBy   User?     @relation("SaleVoidedBy", fields: [voidedById], references: [id])

  items    SaleItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([customerId])
  @@index([status])
}

model SaleItem {
  id       String @id @default(uuid())
  saleId   String
  sale     Sale   @relation(fields: [saleId], references: [id])
  position Int // orden de la línea en la venta

  productId   String
  product     Product @relation(fields: [productId], references: [id])
  // Copia del producto al momento de la venta
  productCode String
  productName String
  unit        String

  quantity            Decimal       @db.Decimal(12, 3)
  unitPrice           Decimal       @db.Decimal(12, 2)
  discountType        DiscountType?
  discountValue       Decimal?      @db.Decimal(12, 2)
  lineDiscount        Decimal       @default(0) @db.Decimal(12, 2) // descuento de la línea (calculado)
  globalDiscountShare Decimal       @default(0) @db.Decimal(12, 2) // parte del descuento general
  taxableBase         Decimal       @db.Decimal(12, 2) // cantidad × precio − descuentos
  ivaRate             IvaRate
  ivaPercent          Decimal       @db.Decimal(5, 2)
  ivaAmount           Decimal       @db.Decimal(12, 2)
  total               Decimal       @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id        String        @id @default(uuid())
  saleId    String
  sale      Sale          @relation(fields: [saleId], references: [id])
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String? // nº de transferencia, voucher de tarjeta, etc.
  createdAt DateTime      @default(now())

  @@index([saleId])
}
